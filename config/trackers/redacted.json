{
  "id": "redacted",
  "name": "Redacted",
  "baseUrl": "https://redacted.sh",
  "enabled": true,
  "engine": "gazelle",
  "login": {
    "url": "login.php",
    "method": "POST",
    "contentType": "form",
    "otpField": "qrcode_confirm"
  },
  "fetch": {
    "fields": {
      "requiredRatio": {
        "regex": "id=\"stats_required\"[^>]*title=\"Required Ratio: (?<value>[^\"]+)\"",
        "transform": "number"
      },
      "unreadMessages": {
        "regex": "data-noty-type=['\"]Inbox['\"][^>]*>[^<]*?(?<value>\\d+)",
        "transform": "integer"
      }
    }
  },
  "api": {
    "url": "ajax.php?action=index",
    "authHeader": "Authorization",
    "authFormat": "{{apiKey}}",
    "fields": {
      "uploadedBytes": {
        "path": "response.userstats.uploaded",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "path": "response.userstats.downloaded",
        "transform": "bytes"
      },
      "ratio": {
        "path": "response.userstats.ratio",
        "transform": "number"
      },
      "requiredRatio": {
        "path": "response.userstats.requiredratio",
        "transform": "number"
      },
      "memberClass": {
        "path": "response.userstats.class",
        "transform": "string"
      },
      "unreadMessages": {
        "path": "response.notifications.messages",
        "transform": "integer"
      }
    },
    "keyInstructions": "Sur RED : Paramètres → Accès → Clés API. Crée une clé avec la permission « User » (sans elle, l'API ne renvoie pas les stats)."
  },
  "dashboard": {
    "byteUnit": "decimal"
  }
}
