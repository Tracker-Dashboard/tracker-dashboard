{
  "id": "speedapp",
  "name": "SpeedApp",
  "baseUrl": "https://speedapp.io",
  "enabled": false,
  "login": {
    "url": "fr/connexion?locale=fr",
    "method": "POST",
    "contentType": "form",
    "preStep": {
      "url": "fr/connexion?locale=fr",
      "extract": {},
      "includeHiddenInputs": true
    },
    "body": {
      "email": "{{username}}",
      "password": "{{password}}",
      "_remember_me": "on"
    },
    "failurePatterns": [
      "Connexion | SpeedApp",
      "name=\"username\"",
      "name=\"password\"",
      "name='_csrf_token'"
    ]
  },
  "fetch": {
    "url": "profile",
    "responseType": "html",
    "fields": {
      "uploadedBytes": {
        "regex": "data-app-user-value=\"[^\"]*?&quot;uploaded&quot;:(?<value>\\d+)[,}]",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "data-app-user-value=\"[^\"]*?&quot;downloaded&quot;:(?<value>\\d+)[,}]",
        "transform": "bytes"
      }
    },
    "extraFetch": {
      "url": "profile/menu-stats",
      "field": "seeding",
      "regex": "title=\"Currently seeding torrents\"[\\s\\S]*?</i>\\s*(?<value>\\d+)",
      "transform": "integer"
    }
  },
  "dashboard": {
    "byteUnit": "decimal"
  }
}
