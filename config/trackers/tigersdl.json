{
  "id": "tigersdl",
  "name": "Tigers-DL",
  "baseUrl": "https://www.tigers-dl.net",
  "enabled": false,
  "login": {
    "url": "login.php",
    "method": "POST",
    "contentType": "form",
    "preStep": {
      "url": "login.php",
      "extract": {
        "csrf_token": {
          "regex": "class=\"form-card\"[\\s\\S]*?name=\"csrf_token\" value=\"(?<value>[^\"]+)\""
        }
      }
    },
    "body": {
      "csrf_token": "{{csrf_token}}",
      "identity": "{{username}}",
      "password": "{{password}}"
    },
    "failurePatterns": [
      "name=\"identity\"",
      "autocomplete=\"current-password\"",
      "type=\"password\""
    ]
  },
  "fetch": {
    "url": "mon-compte.php",
    "mode": "browser",
    "responseType": "html",
    "fields": {
      "uploadedBytes": {
        "regex": "<input\\b(?=[^>]*\\bid=[\"']tracker_uploaded[\"'])[^>]*\\bvalue=[\"'](?<value>[^\"']+)[\"']",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "<input\\b(?=[^>]*\\bid=[\"']tracker_downloaded[\"'])[^>]*\\bvalue=[\"'](?<value>[^\"']+)[\"']",
        "transform": "bytes"
      },
      "ratio": {
        "regex": "<input\\b(?=[^>]*\\bid=[\"']tracker_ratio[\"'])[^>]*\\bvalue=[\"'](?<value>[^\"']+)[\"']",
        "transform": "string"
      },
      "seedBonus": {
        "regex": "<input\\b(?=[^>]*\\bid=[\"']account_seedbonus[\"'])[^>]*\\bvalue=[\"'](?<value>[^\"']+)[\"']",
        "transform": "number"
      }
    }
  },
  "dashboard": {
    "byteUnit": "decimal"
  }
}
