{
  "id": "memphis",
  "name": "Memphis",
  "baseUrl": "https://memphis.fit",
  "enabled": true,
  "login": {
    "cookieOnly": true,
    "failurePatterns": [
      "auth-locked\""
    ]
  },
  "fetch": {
    "url": "/?view=profile",
    "mode": "browser",
    "responseType": "html",
    "fields": {
      "uploadedBytes": {
        "regex": "<strong[^>]*>\\s*(?<value>\\d[\\d\\s.,]*\\s*(?:[KMGTPE](?:i?B|io|o)|B|o))\\s*</strong>\\s*<span[^>]*>\\s*Envoyé\\s*</span>",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "<strong[^>]*>\\s*(?<value>\\d[\\d\\s.,]*\\s*(?:[KMGTPE](?:i?B|io|o)|B|o))\\s*</strong>\\s*<span[^>]*>\\s*Reçu\\s*</span>",
        "transform": "bytes"
      },
      "ratio": {
        "regex": "<strong[^>]*>\\s*(?<value>(?:\\d[\\d\\s.,]*|[Ii]nf(?:inite|inity)?|∞))\\s*</strong>\\s*<span[^>]*>\\s*Ratio\\s+(?:indicatif|historique)\\s*</span>",
        "transform": "number"
      },
      "seeding": {
        "regex": "(?:En\\s+seed\\s+actuellement\\s*</strong>\\s*<span[^>]*>|Mon\\s+empreinte\\s+de\\s+disponibilité[\\s\\S]{0,1200}?<strong[^>]*>)\\s*(?<value>\\d+)",
        "transform": "integer"
      },
      "seedBonus": {
        "regex": "<div\\b[^>]*\\bclass=[\"'][^\"']*\\bimpact-balance\\b[^\"']*[\"'][^>]*>\\s*<span\\b[^>]*>\\s*Points disponibles\\s*</span>\\s*<strong\\b[^>]*>\\s*(?<value>\\d(?:[\\d\\s.,]*\\d)?)\\s*</strong>\\s*<small\\b[^>]*>\\s*points Impact\\s*</small>",
        "transform": "string"
      },
      "memberClass": {
        "regex": "<[^>]+\\bclass=[\"'][^\"']*\\bprofile-banner\\b[^\"']*[\"'][^>]*>(?:(?!</section>|<[^>]+\\bclass=[\"'][^\"']*\\beyebrow\\b)[\\s\\S]){0,1600}?<(?<roleTag>[a-z][a-z0-9]*)\\b[^>]*\\bclass=[\"'][^\"']*\\beyebrow\\b[^\"']*[\"'][^>]*>\\s*(?<value>[A-Za-zÀ-ÿ][^<>]*?)\\s*</\\k<roleTag>>",
        "transform": "string"
      }
    }
  },
  "dashboard": {
    "byteUnit": "binary",
    "bonusUnit": "Impact"
  }
}
