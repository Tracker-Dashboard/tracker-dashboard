{
  "id": "hdforever",
  "name": "HD-Forever",
  "baseUrl": "https://hdf.world",
  "enabled": true,
  "engine": "gazelle",
  "login": {
    "url": "login.php",
    "method": "POST",
    "contentType": "form",
    "body": {
      "username": "{{username}}",
      "password": "{{password}}",
      "login": "Se connecter",
      "keeplogged": "1"
    },
    "otpStep": {
      "urlContains": "login.php",
      "action": "login.php?act=otp",
      "field": "otp_code",
      "body": {
        "validate_otp": "Valider le code"
      }
    },
    "failurePatterns": [
      "Identifiant ou mot de passe incorrect",
      "type=\"password\"",
      "href=\"login.php\"",
      "Entrer</a>"
    ]
  },
  "fetch": {
    "mode": "browser",
    "fields": {
      "uploadedBytes": {
        "regex": "class=\"stat tooltip up\" title=\"(?<value>[^\"]+)\"",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "class=\"stat tooltip dl\" title=\"(?<value>[^\"]+)\"",
        "transform": "bytes"
      },
      "ratio": {
        "regex": "stats_ratio[^>]*>Ratio[^<]*<[^>]*><span class=\"tooltip r\\d+\" title=\"(?<value>[^\"]+)\"",
        "transform": "number"
      },
      "seedBonus": {
        "regex": "action=rate[^>]+>(?<value>[\\d,]+)<",
        "transform": "string"
      },
      "unreadMessages": {
        "regex": "data-notification-type=['\"]Inbox['\"][^>]*>[^<]*?(?<value>\\d+|\\bun) nouveau",
        "transform": "string"
      },
      "memberClass": {
        "regex": "class=\"userclass\">\\((?<value>[^)]+)\\)",
        "transform": "string"
      }
    }
  },
  "api": {
    "url": "api.php?endpoint=self",
    "authHeader": "X-Api-Key",
    "authFormat": "{{apiKey}}",
    "fields": {
      "uploadedBytes": {
        "path": "response.uploaded",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "path": "response.downloaded",
        "transform": "bytes"
      },
      "ratio": {
        "path": "response.ratio",
        "transform": "number"
      },
      "seedBonus": {
        "path": "response.bonus_points",
        "transform": "string"
      },
      "tokens": {
        "path": "response.fl_tokens",
        "transform": "integer"
      },
      "memberClass": {
        "path": "response.class",
        "transform": "string"
      }
    },
    "keyInstructions": "Sur HD-Forever : Intégrations → API. Limite du site : 60 appels / 10 min par compte, sans risque au rythme du dashboard."
  },
  "dashboard": {
    "byteUnit": "decimal"
  }
}
