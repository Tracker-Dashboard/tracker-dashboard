{
  "id": "phoenixproject",
  "name": "Phoenix Project",
  "baseUrl": "https://phoenixproject.app",
  "enabled": true,
  "engine": "gazelle",
  "login": {
    "url": "login.php",
    "method": "POST",
    "contentType": "form",
    "mode": "browser",
    "body": {
      "username": "{{username}}",
      "password": "{{password}}",
      "twofa": "{{totp}}",
      "login": "Log in"
    },
    "failurePatterns": [
      "This is a mirage",
      "Enter</a>"
    ]
  },
  "fetch": {
    "fields": {
      "uploadedBytes": {
        "regex": "id=\"stats_seeding\"[\\s\\S]{0,200}?title=\"(?<value>[^\"]+)\"",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "id=\"stats_leeching\"[\\s\\S]{0,200}?title=\"(?<value>[^\"]+)\"",
        "transform": "bytes"
      },
      "ratio": {
        "regex": "id=\"stats_ratio\"[\\s\\S]{0,200}?title=\"(?<value>[^\"]+)\"",
        "transform": "number"
      },
      "seedBonus": {
        "regex": "Bonus \\((?<value>[^)]+)\\)",
        "transform": "string"
      },
      "unreadMessages": {
        "regex": "data-noty-type=['\"]Inbox['\"][^>]*>[^<]*?(?<value>\\d+|\\ba) new message",
        "transform": "string"
      }
    }
  },
  "api": {
    "url": "ajax.php?action=index",
    "authHeader": "Authorization",
    "authFormat": "token {{apiKey}}",
    "fields": {
      "uploadedBytes": {
        "path": "response.userstats.uploaded",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "path": "response.userstats.downloaded",
        "transform": "bytes"
      },
      "seedBonus": {
        "path": "response.userstats.bonusPoints",
        "transform": "string"
      },
      "memberClass": {
        "path": "response.userstats.class",
        "transform": "string"
      },
      "unreadMessages": {
        "path": "response.notifications.messages",
        "transform": "integer"
      }
    },
    "keyInstructions": "Sur Phoenix Project : Paramètres du profil → section Accès → clés API. Génère une clé et colle-la ici. Le ratio reste lu sur le site (l'API renvoie -1 sans téléchargement)."
  },
  "curlBinary": "curl_firefox135"
}
