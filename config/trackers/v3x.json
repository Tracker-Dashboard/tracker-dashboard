{
  "id": "v3x",
  "name": "V3X",
  "baseUrl": "https://v3x.club",
  "enabled": false,
  "login": {
    "url": "/login",
    "method": "POST",
    "contentType": "form",
    "body": {
      "login": "{{username}}",
      "password": "{{password}}"
    },
    "failurePatterns": [
      "Nom d'utilisateur ou email",
      "Mot de passe oublié"
    ],
    "cookieInstructions": "V3X nécessite un cookie de session valide. Connecte-toi sur v3x.club avec la même IP de sortie que ce tracker. Le cookie est posé sur api.v3x.club, pas sur v3x.club : ouvre https://api.v3x.club, puis copie le cookie v3x_sid (Firefox : Outils de développement → Stockage → Cookies → https://api.v3x.club ; Chrome : Application → Cookies) sous la forme v3x_sid=VALEUR. Ne partage jamais cette valeur : elle donne accès à ta session. Renouvelle-la si le message « session navigateur non authentifiée » apparaît."
  },
  "fetch": {
    "url": "/activity",
    "mode": "browser",
    "responseType": "html",
    "fields": {
      "uploadedBytes": {
        "regex": "[Uu][Pp][Ll][Oo][Aa][Dd][\\s\\S]{0,80}?</span>\\s*<span[^>]*\\bfont-mono\\b[^>]*>\\s*(?<value>[\\d\\s.,]+\\s*(?:[KMGTPE](?:i?B|io|o)|B|o))",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "[Dd][Oo][Ww][Nn][Ll][Oo][Aa][Dd][\\s\\S]{0,80}?</span>\\s*<span[^>]*\\bfont-mono\\b[^>]*>\\s*(?<value>[\\d\\s.,]+\\s*(?:[KMGTPE](?:i?B|io|o)|B|o))",
        "transform": "bytes"
      },
      "bufferBytes": {
        "regex": "[Bb][Uu][Ff][Ff][Ee][Rr][\\s\\S]{0,80}?</span>\\s*<span[^>]*\\bfont-mono\\b[^>]*>\\s*(?<value>[+\\-−]?[\\d\\s.,]+\\s*(?:[KMGTPE](?:i?B|io|o)|B|o))",
        "transform": "bytes"
      },
      "ratio": {
        "regex": "[Rr][Aa][Tt][Ii][Oo][\\s\\S]{0,80}?</span>\\s*<span[^>]*\\bfont-mono\\b[^>]*>\\s*(?<value>(?:[\\d\\s.,]+|inf(?:inite|inity)?|∞))",
        "transform": "number"
      },
      "seedTime": {
        "regex": "[Tt][Ee][Mm][Pp][Ss]\\s+[Dd][Ee]\\s+[Ss][Ee][Ee][Dd][\\s\\S]{0,80}?</span>\\s*<span[^>]*\\bfont-mono\\b[^>]*>\\s*(?<value>\\d+\\s*j(?:\\s*\\d+\\s*h)?(?:\\s*\\d+\\s*m)?)",
        "transform": "string"
      },
      "seedBonus": {
        "regex": "[Pp][Oo][Ii][Nn][Tt][Ss](?!\\s*/\\s*[Hh])[\\s\\S]{0,80}?</span>\\s*<span[^>]*\\bfont-mono\\b[^>]*>\\s*(?<value>[\\d\\s.,]+)",
        "transform": "string"
      },
      "pointsPerHour": {
        "regex": "[Pp][Oo][Ii][Nn][Tt][Ss]\\s*/\\s*[Hh][\\s\\S]{0,80}?</span>\\s*<span[^>]*\\bfont-mono\\b[^>]*>\\s*(?<value>[+\\-]?[\\d\\s.,]+)",
        "transform": "number"
      },
      "seeding": {
        "regex": "[Ss]eeds?\\s+en\\s+cours(?:[^<]|<!--[\\s\\S]*?-->){0,80}?<span[^>]*>\\s*(?<value>\\d+)\\s*</span>",
        "transform": "integer"
      }
    },
    "extraFetch": {
      "url": "https://api.v3x.club/auth/me",
      "responseType": "json",
      "field": "uploadedBytes",
      "path": "uploaded",
      "transform": "bytes",
      "extraFields": {
        "downloadedBytes": {
          "path": "downloaded",
          "transform": "bytes"
        },
        "ratio": {
          "path": "ratio",
          "transform": "number"
        },
        "seedBonus": {
          "path": "bonusPoints",
          "transform": "string"
        },
        "tokens": {
          "path": "freeleechTokens",
          "transform": "integer"
        },
        "hitAndRuns": {
          "path": "hnr.active",
          "transform": "integer"
        }
      }
    }
  },
  "dashboard": {
    "byteUnit": "binary"
  }
}
