{
  "id": "tr4ker",
  "name": "TR4KER",
  "baseUrl": "https://tr4ker.net",
  "enabled": true,
  "login": {
    "url": "login",
    "method": "POST",
    "contentType": "form",
    "body": {
      "username": "{{username}}",
      "email": "{{username}}",
      "password": "{{password}}"
    },
    "failurePatterns": [
      "type=\"password\"",
      "name=\"password\"",
      "href=\"/login\"",
      "aria-label=\"Connexion\"",
      "Inscription"
    ],
    "cookieOnly": true
  },
  "fetch": {
    "url": "mon-compte/profil",
    "mode": "browser",
    "responseType": "html",
    "fields": {
      "ratio": {
        "regex": ">[Rr][Aa][Tt][Ii][Oo]<[\\s\\S]{0,180}?_metricValue_[^>]*>\\s*(?<value>\\d[\\d\\s.,]*)\\s*<",
        "transform": "number"
      },
      "uploadedBytes": {
        "regex": ">[Uu][Pp][Ll][Oo][Aa][Dd]<[\\s\\S]{0,180}?_metricValue_[^>]*>\\s*(?<value>\\d[\\d\\s.,]*)\\s*</span>\\s*<span[^>]*_metricUnit_[^>]*>\\s*(?<unit>[KMGTPE](?:i?B|io|o)|B|o)\\s*<",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": ">[Dd][Oo][Ww][Nn][Ll][Oo][Aa][Dd]<[\\s\\S]{0,180}?_metricValue_[^>]*>\\s*(?<value>\\d[\\d\\s.,]*)\\s*</span>\\s*<span[^>]*_metricUnit_[^>]*>\\s*(?<unit>[KMGTPE](?:i?B|io|o)|B|o)\\s*<",
        "transform": "bytes"
      },
      "seeding": {
        "regex": ">[Ss][Ee][Ee][Dd][Ss]<[\\s\\S]{0,180}?_metricValue_[^>]*>\\s*(?<value>\\d+)\\s*<",
        "transform": "integer"
      },
      "memberClass": {
        "regex": "_roleBadge_[^>]*>\\s*(?<value>[^<]+)<",
        "transform": "string"
      }
    },
    "extraFetch": {
      "url": "shop",
      "responseType": "html",
      "field": "seedBonus",
      "regex": ">Crédit<[\\s\\S]{0,180}?_balanceValue_[^>]*>\\s*(?<value>\\d[\\d\\s.,]*)\\s*<",
      "transform": "string"
    }
  },
  "dashboard": {
    "byteUnit": "decimal"
  }
}
