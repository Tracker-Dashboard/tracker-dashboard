{
  "id": "mam",
  "name": "MAM",
  "baseUrl": "https://www.myanonamouse.net",
  "enabled": false,
  "login": {
    "url": "login.php?returnto=%2Fu%2F",
    "method": "POST",
    "contentType": "form",
    "preStep": {
      "url": "login.php?returnto=%2Fu%2F",
      "extract": {},
      "includeHiddenInputs": true
    },
    "body": {
      "email": "{{username}}",
      "password": "{{password}}",
      "rememberMe": "yes",
      "returnto": "/u/"
    },
    "failurePatterns": [
      "Not logged in!",
      "Login | My Anonamouse",
      "name=\"password\"",
      "name='password'",
      "loginIssueBlock"
    ],
    "cookieOnly": true,
    "cookieInstructions": "Paste the MAM API session cookie mam_id only; do not include uid or mbsc. Create an API session in MAM Settings → Security."
  },
  "fetch": {
    "url": "jsonLoad.php?snatch_summary",
    "mode": "http",
    "responseType": "json",
    "fields": {
      "uploadedBytes": {
        "path": "uploaded_bytes",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "path": "downloaded_bytes",
        "transform": "bytes"
      },
      "ratio": {
        "path": "ratio",
        "transform": "number"
      },
      "seedBonus": {
        "path": "seedbonus",
        "transform": "string"
      }
    }
  },
  "dashboard": {
    "byteUnit": "binary"
  }
}
