{
  "id": "anthelion",
  "name": "Anthelion",
  "baseUrl": "https://anthelion.me",
  "enabled": false,
  "engine": "gazelle",
  "login": {
    "otpField": "twofa"
  },
  "fetch": {
    "fields": {
      "uploadedBytes": {
        "regex": "id=\"stats_uploaded\"(?:(?!</li>)[\\s\\S])*?<span class=\"stat[^\"]*\"[^>]*>(?:\\s|&nbsp;|&#160;|&#xa0;)*(?:<[a-z][^>]*>(?:\\s|&nbsp;|&#160;|&#xa0;)*)*(?<value>(?!&(?:nbsp|#160|#xa0);)[^<\\s][^<]*?)(?:\\s|&nbsp;|&#160;|&#xa0;)*<",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "id=\"stats_downloaded\"(?:(?!</li>)[\\s\\S])*?<span class=\"stat[^\"]*\"[^>]*>(?:\\s|&nbsp;|&#160;|&#xa0;)*(?:<[a-z][^>]*>(?:\\s|&nbsp;|&#160;|&#xa0;)*)*(?<value>(?!&(?:nbsp|#160|#xa0);)[^<\\s][^<]*?)(?:\\s|&nbsp;|&#160;|&#xa0;)*<",
        "transform": "bytes"
      },
      "ratio": {
        "regex": "id=\"stats_ratio\"(?:(?!</li>)[\\s\\S])*?<span class=\"stat[^\"]*\"[^>]*>(?:\\s|&nbsp;|&#160;|&#xa0;)*(?:<[a-z][^>]*>(?:\\s|&nbsp;|&#160;|&#xa0;)*)*(?<value>(?!&(?:nbsp|#160|#xa0);)[^<\\s][^<]*?)(?:\\s|&nbsp;|&#160;|&#xa0;)*<",
        "transform": "number"
      },
      "seeding": {
        "regex": "id=\"header_user_commstats_seeding\"[^>]*>\\s*(?<value>\\d+(?:(?:[,\\s]|&nbsp;|&#160;|&#xa0;)\\d{3})*)\\s*<",
        "transform": "integer"
      },
      "leeching": {
        "regex": "id=\"header_user_commstats_leeching\"[^>]*>\\s*(?<value>\\d+(?:(?:[,\\s]|&nbsp;|&#160;|&#xa0;)\\d{3})*)\\s*<",
        "transform": "integer"
      },
      "tokens": {
        "regex": "id=\"fl_tokens\"(?:(?!</li>)[\\s\\S])*?<span class=\"stat[^\"]*\"[^>]*>(?:\\s|&nbsp;|&#160;|&#xa0;)*(?:<[a-z][^>]*>(?:\\s|&nbsp;|&#160;|&#xa0;)*)*(?<value>(?!&(?:nbsp|#160|#xa0);)[^<\\s][^<]*?)(?:\\s|&nbsp;|&#160;|&#xa0;)*<",
        "transform": "integer"
      },
      "seedBonus": {
        "regex": "id=\"bonus_points\"(?:(?!</li>)[\\s\\S])*?<span class=\"stat[^\"]*\"[^>]*>(?:\\s|&nbsp;|&#160;|&#xa0;)*(?:<[a-z][^>]*>(?:\\s|&nbsp;|&#160;|&#xa0;)*)*(?<value>(?!&(?:nbsp|#160|#xa0);)[^<\\s][^<]*?)(?:\\s|&nbsp;|&#160;|&#xa0;)*<",
        "transform": "string"
      }
    },
    "extraFetch": {
      "url": "user.php?id={{id}}",
      "responseType": "html",
      "field": "memberClass",
      "idExtract": {
        "regex": "href=\"user\\.php\\?id=(?<value>\\d+)\" class=\"username\""
      },
      "regex": ">(?:\\s|&nbsp;|&#160;|&#xa0;)*Class:(?:\\s|&nbsp;|&#160;|&#xa0;)*(?:<[a-z][^>]*>(?:\\s|&nbsp;|&#160;|&#xa0;)*)*(?<value>(?!&(?:nbsp|#160|#xa0);)[^<\\s][^<]*?)(?:\\s|&nbsp;|&#160;|&#xa0;)*<",
      "transform": "string"
    }
  }
}
