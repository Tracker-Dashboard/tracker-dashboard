{
  "id": "astratorrent",
  "name": "AstraTorrent",
  "baseUrl": "https://astratorrent.la",
  "announceHosts": [
    "astratorrent.cc"
  ],
  "enabled": false,
  "login": {
    "url": "login.php",
    "method": "POST",
    "contentType": "form",
    "body": {
      "loginUsername": "{{username}}",
      "loginPassword": "{{password}}"
    },
    "failurePatterns": [
      "id=\"formLogin\"",
      "Identifiants invalides",
      "Mot de passe incorrect"
    ]
  },
  "fetch": {
    "url": "compte.php",
    "mode": "browser",
    "responseType": "html",
    "fields": {
      "uploadedBytes": {
        "regex": "<span>⬆️\\s*(?<value>[\\d\\s.,]+\\s*[KMGTPE]?(?:i?[Bo]|o))\\s*</span>",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "<span>⬇️\\s*(?<value>[\\d\\s.,]+\\s*[KMGTPE]?(?:i?[Bo]|o))\\s*</span>",
        "transform": "bytes"
      },
      "points": {
        "regex": "\\bvar\\s+userKarmaPoints\\s*=\\s*(?<value>\\d+(?:\\.\\d+)?)\\s*;",
        "transform": "number"
      },
      "seeding": {
        "regex": "🌱\\s*(?<value>\\d+)\\s+seeds actifs",
        "transform": "integer"
      }
    }
  },
  "dashboard": {
    "byteUnit": "decimal"
  },
  "ratioless": true
}
