{
  "id": "astratorrent",
  "name": "AstraTorrent",
  "baseUrl": "https://astratorrent.la/v2",
  "announceHosts": [
    "astratorrent.cc"
  ],
  "enabled": false,
  "login": {
    "url": "login.php",
    "method": "POST",
    "contentType": "form",
    "body": {
      "loginUsername": "{{username}}",
      "loginPassword": "{{password}}"
    },
    "failurePatterns": [
      "id=\"formLogin\"",
      "Identifiants invalides",
      "Mot de passe incorrect"
    ]
  },
  "fetch": {
    "url": "compte.php",
    "mode": "browser",
    "responseType": "html",
    "fields": {
      "uploadedBytes": {
        "regex": "\"uploaded_bytes\"\\s*:\\s*(?<value>\\d+)",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "\"downloaded_bytes\"\\s*:\\s*(?<value>\\d+)",
        "transform": "bytes"
      },
      "ratio": {
        "regex": "\"ratio\"\\s*:\\s*\"(?<value>∞|[\\d.,]+)\"",
        "transform": "number"
      },
      "seedBonus": {
        "regex": "\"bonus_points\"\\s*:\\s*(?<value>[\\d.]+)",
        "transform": "number"
      }
    }
  },
  "dashboard": {
    "byteUnit": "decimal"
  }
}
