{
  "id": "orpheus",
  "name": "Orpheus",
  "baseUrl": "https://orpheus.network",
  "enabled": true,
  "engine": "gazelle",
  "login": {
    "url": "login.php",
    "method": "POST",
    "contentType": "form",
    "otpField": "mfa"
  },
  "fetch": {
    "fields": {
      "downloadedBytes": {
        "regex": "id=\"stats_leeching\"[\\s\\S]*?title=\"(?<value>[^\"]+)\"",
        "transform": "bytes"
      },
      "uploadedBytes": {
        "regex": "id=\"stats_seeding\"[\\s\\S]*?title=\"(?<value>[^\"]+)\"",
        "transform": "bytes"
      },
      "ratio": {
        "regex": "id=\"stats_ratio\"[\\s\\S]*?title=\"(?<value>[^\"]+)\"",
        "transform": "number"
      },
      "seedBonus": {
        "regex": "Bonus \\((?<value>[^)]+)\\)",
        "transform": "string"
      },
      "unreadMessages": {
        "regex": "data-noty-type=['\"]Inbox['\"][^>]*>[^<]*?(?<value>\\d+|\\ba) new message",
        "transform": "string"
      }
    },
    "extraFetch": {
      "url": "torrents.php?type=seeding&userid={{id}}",
      "field": "seeding",
      "idExtract": {
        "regex": "href=\"user\\.php\\?id=(?<value>\\d+)\" class=\"username\""
      },
      "regex": "(?<value>\\d+)\\s+torrents? found",
      "transform": "integer"
    }
  },
  "api": {
    "url": "ajax.php?action=index",
    "authHeader": "Authorization",
    "authFormat": "token {{apiKey}}",
    "fields": {
      "uploadedBytes": {
        "path": "response.userstats.uploaded",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "path": "response.userstats.downloaded",
        "transform": "bytes"
      },
      "ratio": {
        "path": "response.userstats.ratio",
        "transform": "number"
      },
      "seedBonus": {
        "path": "response.userstats.bonusPoints",
        "transform": "string"
      },
      "tokens": {
        "path": "response.userstats.tokens",
        "transform": "integer"
      },
      "memberClass": {
        "path": "response.userstats.class",
        "transform": "string"
      },
      "unreadMessages": {
        "path": "response.notifications.messages",
        "transform": "integer"
      }
    },
    "keyInstructions": "Sur OPS : Paramètres du profil → section Accès → clés API. Génère une clé et colle-la ici."
  }
}
